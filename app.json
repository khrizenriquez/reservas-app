{
  "expo": {
    "name": "Reservas UMG",
    "slug": "reservas-umg",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "reservasumg",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17355F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
